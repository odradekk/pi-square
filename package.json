{
  "name": "@odradekk/pi-square",
  "version": "0.1.0",
  "description": "Unified local extension package for Pi",
  "type": "module",
  "license": "MIT",
  "author": "s1n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odradekk/pi-square.git"
  },
  "homepage": "https://github.com/odradekk/pi-square#readme",
  "bugs": {
    "url": "https://github.com/odradekk/pi-square/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension"
  ],
  "files": [
    "bin",
    "resources",
    "skills",
    "src",
    "themes",
    "wasm",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@types/node": "^24.0.0",
    "@types/ssh2": "1.15.5",
    "jiti": "^2.7.0",
    "typebox": "1.1.38",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "scripts": {
    "test": "node ./tests/run.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node ./tests/smoke.mjs",
    "package:check": "npm pack --dry-run --json | node ./scripts/verify-pack.mjs",
    "eval:codegraph": "node ./tests/codegraph/eval.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "dependencies": {
    "@ast-grep/cli": "0.44.1",
    "@cantoo/pdf-lib": "2.7.3",
    "@colbymchenry/codegraph": "1.4.1",
    "pdfjs-dist": "6.1.200",
    "ssh2": "1.17.0"
  }
}
